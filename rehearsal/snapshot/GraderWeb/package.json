{
  "name": "grader-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:api": "ng-openapi -c openapi.config.ts",
    "prestart": "npm run generate:api",
    "start": "ng serve",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate:api",
    "test": "ng test",
    "e2e": "playwright test",
    "check": "biome check --error-on-warnings",
    "fix": "biome check --write"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/archivo": "^5.3.0",
    "@lucide/angular": "^1.48.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "jsdom": "^30.0.0",
    "ng-openapi": "^0.4.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
