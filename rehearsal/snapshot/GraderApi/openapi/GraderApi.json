{
  "openapi": "3.2.0",
  "info": {
    "title": "GraderApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/calculator/add": {
      "get": {
        "tags": [
          "Calculator"
        ],
        "summary": "Adds two numbers",
        "description": "Adds two non-negative integers. Negative parameters are rejected with a problem details response.",
        "operationId": "Add",
        "parameters": [
          {
            "name": "a",
            "in": "query",
            "description": "First summand, must not be negative.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "b",
            "in": "query",
            "description": "Second summand, must not be negative.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddResult": {
        "required": [
          "result"
        ],
        "type": "object",
        "properties": {
          "result": {
            "type": "integer",
            "description": "Sum of the two parameters.",
            "format": "int32"
          }
        },
        "description": "Result of an addition."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Calculator"
    }
  ]
}